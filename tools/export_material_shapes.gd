extends SceneTree
const Content=preload("res://scripts/content.gd")
func key(s:Dictionary)->String:
	return "%s|%.3f|%.3f|%.3f|%.3f|%.3f|%d"%[s.kind,s.w,s.h,s.get("gap",0),s.get("offset",0),s.get("surface",0),s.treasure]
func _initialize()->void:
	var unique={}
	for i in range(12):
		for s in Content.sequence(i).pieces: unique[key(s)]=s
	for s in [Content.shape("slab",330,26),Content.shape("bridge",290,100,230),Content.shape("slab",164,30),Content.shape("wedge",104,64),Content.shape("slab",354,18)]:unique[key(s)]=s
	for n in range(1,4):
		for size in [Vector2(56,60),Vector2(64,68),Vector2(32,38),Vector2(42,42)]:
			var s=Content.shape("core",size.x,size.y,0,0,n);unique[key(s)]=s
	var foundation={"kind":"foundation","w":200.0,"h":74.0,"gap":0,"offset":0,"surface":1,"treasure":0,"polys":[Content.rect(-100,-37,200,34),Content.rect(-76,-3,152,40)]}
	unique[key(foundation)]=foundation
	var shapes=[]
	for k in unique:
		var s=unique[k]
		var contours=[]
		for poly in s.polys:
			var remaining=poly
			var index=0
			while index<contours.size():
				var merged=Geometry2D.merge_polygons(contours[index],remaining)
				if merged.size()==1:
					remaining=merged[0];contours.remove_at(index);index=0
				else:index+=1
			contours.append(remaining)
		var serial=[]
		for poly in contours:
			var points=[]
			for p in poly:points.append([p.x,p.y])
			serial.append(points)
		shapes.append({"key":k,"file":k.sha256_text().substr(0,16)+".png","w":s.w,"h":s.h,"number":s.treasure,"surface":s.get("surface",0),"contours":serial})
	var f=FileAccess.open("res://assets/materials/shapes.json",FileAccess.WRITE)
	f.store_string(JSON.stringify(shapes,"\t"));f.close()
	var catalog=FileAccess.open("res://scripts/material_catalog.gd",FileAccess.WRITE)
	catalog.store_string("# Generated by tools/export_material_shapes.gd; exact collision-union contours.\nextends RefCounted\nconst ENTRIES = "+JSON.stringify(shapes,"\t")+"\n")
	catalog.close()
	print("Exported exact union silhouettes: ",shapes.size())
	quit()
